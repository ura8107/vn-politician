# Copy this file to .env.local for local development.
#
# NEXT_PUBLIC_* values are inlined at build time, so they must also be present
# in the environment that runs `npm run deploy` (and in the matching `vars`
# entry of wrangler.jsonc for server-side reads at runtime).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side secrets live in .dev.vars locally and in `wrangler secret`
# in production. See .dev.vars.example.
