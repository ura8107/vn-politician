# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# python
__pycache__/
*.pyc

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*.local
.env

# generated by `npm run db:generate-seed` from data/import/assembly_members.csv
/data/seed/

# cloudflare
.open-next/
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example

# typescript
*.tsbuildinfo
next-env.d.ts
